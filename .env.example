# Copia este archivo como .env para trabajar en tu computadora.
# En Vercel, estas mismas variables se configuran en Settings → Environment Variables.
# NUNCA subas el archivo .env a GitHub.

# Conexión a Supabase: Project → Connect → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de tu base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave para firmar las sesiones. Usa un texto largo y aleatorio (mínimo 32 caracteres).
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Opcionales
PORT=3000
SESION_HORAS=8
APP_TIMEZONE=America/Lima

# Asistente IA con OpenAI (opcional). Si lo dejas en "local" funciona con el motor de reglas.
IA_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
